{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Material spec: the content of one lesson's material box",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_line", "concepts", "steps", "diagram", "table", "decisions", "tips"],
  "properties": {
    "title_line": {"type": "string", "maxLength": 70, "description": "Red line at the top: the lesson's topic in a few words"},
    "concepts": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "text"],
        "properties": {
          "name": {"type": "string", "maxLength": 18, "description": "Card label, e.g. 'Shard'"},
          "keyword": {"type": "string", "maxLength": 22, "description": "Optional 1-3 word cue under the card, e.g. 'unit of scale'"},
          "text": {"type": "string", "maxLength": 160, "description": "One or two short sentences"},
          "tag": {"type": "string", "maxLength": 45, "description": "Optional AWS service name(s) this concept is about, e.g. 'Amazon Kinesis Data Streams'"}
        }}
    },
    "steps": {
      "type": "object", "additionalProperties": false, "required": ["heading", "items"],
      "properties": {
        "heading": {"type": "string", "maxLength": 30, "description": "A 3-step process, lifecycle or progression from the lesson"},
        "items": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "object", "additionalProperties": false, "required": ["label", "text"],
            "properties": {"label": {"type": "string", "maxLength": 18}, "text": {"type": "string", "maxLength": 110}}}}
      }
    },
    "diagram": {
      "type": "object", "additionalProperties": false, "required": ["heading", "groups", "edges"],
      "description": "The lesson's architecture as a left-to-right flowchart. Groups are columns (left to right); edges should mostly go between neighbouring groups.",
      "properties": {
        "heading": {"type": "string", "maxLength": 45},
        "groups": {"type": "array", "minItems": 2, "maxItems": 4,
          "items": {"type": "object", "additionalProperties": false, "required": ["title", "nodes"],
            "properties": {
              "title": {"type": "string", "maxLength": 18},
              "nodes": {"type": "array", "minItems": 1, "maxItems": 3,
                "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"],
                  "properties": {"id": {"type": "string", "maxLength": 12}, "label": {"type": "string", "maxLength": 40}}}}
            }}},
        "edges": {"type": "array", "minItems": 2, "maxItems": 7,
          "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "label"],
            "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string", "maxLength": 22}}}}
      }
    },
    "table": {
      "type": "object", "additionalProperties": false, "required": ["heading", "columns", "rows"],
      "description": "Key facts, limits or a comparison from the lesson",
      "properties": {
        "heading": {"type": "string", "maxLength": 30},
        "columns": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "maxLength": 18}},
        "rows": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "maxLength": 70}}}
      }
    },
    "decisions": {
      "type": "object", "additionalProperties": false, "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 4, "maxItems": 6,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "maxLength": 75}},
          "description": "[if the scenario says..., choose..., because...]"}
      }
    },
    "tips": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "maxLength": 120}}
  }
}
