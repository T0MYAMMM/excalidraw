    {
     "keyword": "Sync shard polling",
     "name": "Event Source Map",
     "tag": "AWS Lambda",
     "text": "Lambda polls shards and invokes synchronously in order. Filter criteria drop unmatched events before invocation."
    },
    {
     "keyword": "At-least-once",
     "name": "Failure & Retries",
     "tag": "Amazon Kinesis",
     "text": "Failed batches retry until expiry and block the shard. Combine bisect, max retries/age, partial batch failures, and idempotent writes."
    },
    {
     "keyword": "Dedicated 2 MB/s",
     "name": "Fan-out & CDC",
     "tag": "Amazon DynamoDB",
     "text": "Enhanced fan-out gives each consumer 2 MB/s per shard. DynamoDB Streams keeps 24h item CDC; use KDS for longer retention."
    }
   ],
