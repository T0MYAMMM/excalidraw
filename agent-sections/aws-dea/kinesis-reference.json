  "x": 5594,
  "y": -10160,
  "width": 132,
  "height": 20,
  "text": "- Main Features",
  "fontSize": 16
 },
 {
  "type": "rectangle",
  "id": "kds-f1",
  "x": 5609,
  "y": -10130,
  "width": 135,
  "height": 31,
  "backgroundColor": "#38d9a9",
  "strokeWidth": 1,
  "roughness": 0,
  "label": {
   "text": "1. Shards & Capacity",
   "fontSize": 8.36
  }
 },
 {
  "type": "text",
  "id": "kds-f1t",
  "x": 5754,
  "y": -10132,
  "width": 351,
  "height": 22,
  "text": "Each shard takes 1 MB/s or 1,000 records/s in and serves 2 MB/s out.\nOn-demand mode adds shards for you; provisioned mode you size yourself.",
  "fontSize": 9
 },
 {
  "type": "rectangle",
  "id": "kds-f2",
  "x": 5609,
  "y": -10085,
  "width": 135,
  "height": 31,
  "backgroundColor": "#96f2d7",
  "strokeWidth": 1,
  "roughness": 0,
  "label": {
   "text": "2. Partition Key & Ordering",
   "fontSize": 8.36
  }
 },
 {
  "type": "text",
  "id": "kds-f2t",
  "x": 5754,
  "y": -10087,
  "width": 351,
  "height": 22,
  "text": "The partition key picks the shard. Order is kept only within one shard.\nOne hot key = one hot shard (ProvisionedThroughputExceeded).",
  "fontSize": 9
 },
 {
  "type": "rectangle",
  "id": "kds-f3",
  "x": 5609,
  "y": -10040,
  "width": 135,
  "height": 31,
  "backgroundColor": "#38d9a9",
  "strokeWidth": 1,
  "roughness": 0,
  "label": {
   "text": "3. Consumers & Fan-out",
   "fontSize": 8.36
  }
 },
 {
  "type": "text",
  "id": "kds-f3t",
  "x": 5754,
  "y": -10042,
  "width": 327,
  "height": 22,
  "text": "Shared mode: all consumers split 2 MB/s per shard (pull, ~200 ms).\nEnhanced fan-out: 2 MB/s per consumer per shard, pushed (~70 ms).",
  "fontSize": 9
 },
 {
  "type": "rectangle",
  "id": "kds-f4",
  "x": 5609,
  "y": -9995,
  "width": 135,
  "height": 31,
  "backgroundColor": "#96f2d7",
  "strokeWidth": 1,
  "roughness": 0,
  "label": {
   "text": "4. Retention & Replay",
   "fontSize": 8.36
  }
 },
 {
  "type": "text",
  "id": "kds-f4t",
  "x": 5754,
  "y": -9997,
  "width": 332,
  "height": 22,
  "text": "Default 24 h, up to 365 days. Consumers can re-read from a sequence\nnumber or timestamp to reprocess after a bug or to backfill.",
  "fontSize": 9
 },
